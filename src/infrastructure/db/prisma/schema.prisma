generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id            String    @id @default(cuid())
  email         String    @unique
  nombre        String
  telefono      String?
  // El modelo de suscripción mensual se abandonó el 2026-09-05 a favor del
  // pago único (docs/DECISIONES.md, D-09 reemplazada por D-10). El campo
  // sigue aquí porque nada lo lee para decidir: todo Cliente se crea con
  // Plan.STARTER y quitarlo exigiría una migración contra la base de
  // producción sin ninguna ganancia funcional.
  plan          Plan      @default(STARTER)
  activo        Boolean   @default(false)
  fechaCreacion DateTime  @default(now())
  fechaPago     DateTime?
  sitios        Sitio[]
  pagos         Pago[]
  sesiones      Sesion[]
}

model Sitio {
  id            String   @id @default(cuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  subdominio    String   @unique
  dominioPropio String?  @unique
  template      Template
  configJson    Json
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())
  fechaUpdate   DateTime @updatedAt
}

model Pago {
  id         String     @id @default(cuid())
  clienteId  String
  cliente    Cliente    @relation(fields: [clienteId], references: [id])
  monto      Int
  estado     EstadoPago
  proveedor  Proveedor
  referencia String?
  fecha      DateTime   @default(now())
}

model Sesion {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  historial     Json     @default("[]")
  datosJson     Json?
  completada    Boolean  @default(false)
  fechaCreacion DateTime @default(now())
  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
}

model TokenAcceso {
  id            String    @id @default(cuid())
  email         String
  tokenHash     String    @unique
  expiraEn      DateTime
  usadoEn       DateTime?
  fechaCreacion DateTime  @default(now())

  @@index([email])
}

// Vestigio del modelo de suscripción mensual, abandonado el 2026-09-05 en
// favor del pago único (docs/DECISIONES.md, D-09 reemplazada por D-10). Se
// conserva porque eliminarlo requeriría una migración contra la base de
// producción y ningún módulo lee `Cliente.plan` para tomar una decisión.
enum Plan {
  STARTER
  PRO
  AGENCIA
}

enum Template {
  LANDING
  SERVICIOS
  PORTFOLIO
  RESTAURANTE
  TIENDA
}

enum EstadoPago {
  PENDIENTE
  CONFIRMADO
  FALLIDO
  REEMBOLSADO
}

enum Proveedor {
  FLOW
  MERCADOPAGO
  PAYPAL
  TRANSFERENCIA
}
