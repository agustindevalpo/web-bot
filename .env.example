# IA
ANTHROPIC_API_KEY=

# Base de datos (Railway la inyecta automáticamente en el servicio web-bot)
DATABASE_URL=postgresql://...

# Pagos (motor Devalpo — ver Tarea 1.4 en docs/BITACORA.md, todavía no deployado)
FLOW_API_KEY=
FLOW_SECRET_KEY=
MP_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Imágenes
UNSPLASH_ACCESS_KEY=

# Railway (para deploy programático, si hace falta más adelante)
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=

# Auth (login por magic link — ver docs/BITACORA.md)
AUTH_SECRET=
# Envío del magic link vía Gmail Workspace (smtp.gmail.com). GMAIL_APP_PASSWORD
# es una "contraseña de aplicación" (myaccount.google.com > Seguridad >
# Verificación en 2 pasos > Contraseñas de aplicaciones), no la contraseña normal.
# Sin estas dos, el link se loguea a consola en dev y falla en producción.
GMAIL_USER=team@devalpo.cl
GMAIL_APP_PASSWORD=

# App
NEXT_PUBLIC_BASE_DOMAIN=sitios.devalpo.cl
NEXT_PUBLIC_APP_DOMAIN=webbot.devalpo.cl
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PASSWORD=
N8N_WEBHOOK_URL=
