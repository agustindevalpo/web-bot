# IA
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Base de datos (Railway la inyecta automáticamente en el servicio web-bot)
DATABASE_URL=postgresql://...

# Pagos (motor Devalpo — ver Tarea 1.4 en docs/BITACORA.md, todavía no deployado)
FLOW_API_KEY=
FLOW_SECRET_KEY=
MP_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Imágenes
UNSPLASH_ACCESS_KEY=

# Railway (para deploy programático, si hace falta más adelante)
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=

# Auth (login por magic link — ver docs/BITACORA.md)
AUTH_SECRET=
# Envío real del magic link en producción, vía Resend (API HTTP — el SMTP de
# Gmail está bloqueado en el egress de Railway, ver bitácora). RESEND_FROM_EMAIL
# debe ser de un dominio verificado en el dashboard de Resend; sin verificar,
# cae al remitente de pruebas (onboarding@resend.dev, solo entrega a la cuenta
# dueña del API key).
RESEND_API_KEY=
RESEND_FROM_EMAIL=WebBot <team@devalpo.cl>
# Alternativa para dev local (Gmail SMTP funciona fuera de Railway).
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" (myaccount.google.com >
# Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones), no la
# contraseña normal. Sin ninguna credencial (Resend o Gmail), el link se
# loguea a consola en dev y falla en producción.
GMAIL_USER=team@devalpo.cl
GMAIL_APP_PASSWORD=

# App
NEXT_PUBLIC_BASE_DOMAIN=sitios.devalpo.cl
NEXT_PUBLIC_APP_DOMAIN=webbot.devalpo.cl
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PASSWORD=
N8N_WEBHOOK_URL=
